# Copy to api/.env for local development. Never commit a real secret.

# dev | test | prod. Outside dev a placeholder secret refuses to boot.
CFA_APP_ENV=dev

# LIVE | RECORDED_PUBLIC | SYNTHETIC. Shown in the UI, every API response,
# and every export.
CFA_DATA_MODE=SYNTHETIC

# reviewed_sets | synthetic_fixture. Unset follows the data mode: the fictional
# anchors.csv under SYNTHETIC, the reviewed label sets otherwise. LIVE plus
# synthetic_fixture refuses to boot (D019).
# CFA_LABEL_SOURCE=reviewed_sets
# CFA_LABEL_DIR=../data

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CFA_SECRET_KEY=dev-secret-not-for-production

# SQLite is the checked local default. PostgreSQL is a deployment target requiring validation:
#   CFA_DATABASE_URL=postgresql+psycopg://cfa:cfa@localhost:5433/cfa
CFA_DATABASE_URL=sqlite+pysqlite:///../var/cfa.db

# Optional upstream Redis setting. The v2 operations queue uses SQL and does not require Redis.
# CFA_REDIS_URL=redis://localhost:6380/0

# Search budgets. Configuration targets, not measured performance.
CFA_BUDGET_MAX_HOPS=8
CFA_BUDGET_MAX_EVENTS=5000
CFA_BUDGET_MAX_PROVIDER_REQUESTS=400
CFA_BUDGET_WALL_CLOCK_SECONDS=300

# Leave unset: without a key the live adapter stays disabled rather than
# silently returning empty histories, and `make validate-live` refuses to run.
# A key here does NOT make the test suite reach the network: live tests are
# deselected by default and need `pytest -m live` plus CFA_LIVE_TESTS=1.
# For LIVE use a separate database/environment; never mix with the synthetic demo database.
# Create one in the TronGrid console; it is sent as the TRON-PRO-API-KEY header
# and grants API access only — it signs nothing and moves nothing.
# CFA_TRON_API_BASE=https://api.trongrid.io
# CFA_TRON_API_KEY=

# Leave unset: without an RPC URL, Ethereum LIVE acquisition stays disabled
# rather than silently choosing a public endpoint we did not vet. A standard
# JSON-RPC endpoint for Ethereum Mainnet (chain_id 1); the adapter refuses to
# proceed if the endpoint answers with a different chain id. May embed a
# provider API key in its path/query -- it is never logged, printed, or
# written into a saved evidence bundle, only whether it is configured.
# CFA_ETHEREUM_RPC_URL=

# BNB Smart Chain Mainnet (chain_id 56). Its own setting, fully independent of
# CFA_ETHEREUM_RPC_URL: neither is ever used for the other network, and the
# adapter refuses an endpoint that does not answer eth_chainId = 56. Same
# secret handling: never logged, printed, or saved -- only whether it is set.
# Leave unset to keep BSC LIVE acquisition disabled.
# CFA_BSC_RPC_URL=
#
# Base Mainnet (chain_id 8453). Its own setting, fully independent of Ethereum
# and BSC: neither is ever used for another network, and the adapter refuses an
# endpoint that does not answer eth_chainId = 8453. Same secret handling: never
# logged, printed, or saved -- only whether it is set. Leave unset to keep Base
# LIVE acquisition disabled.
# CFA_BASE_RPC_URL=
